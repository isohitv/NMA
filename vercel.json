{
  "version": 2,
  "buildCommand": "npm run build:renderer",
  "outputDirectory": "dist/renderer",
  "framework": "vite",
  "functions": {
    "api/index.ts": {
      "runtime": "nodejs20.x",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/((?!api/).*)", "destination": "/" }
  ]
}
